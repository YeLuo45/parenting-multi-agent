{
	"name": "@parenting/web",
	"version": "0.1.0",
	"description": "Vite + React Dashboard for parenting-multi-agent — chat UI, child profile, agent activity",
	"type": "module",
	"private": true,
	"scripts": {
		"clean": "rm -rf dist",
		"dev": "vite",
		"build": "tsc -p tsconfig.json && vite build",
		"build:e2e": "tsc -p tsconfig.json && vite build --base ./",
		"preview": "vite preview",
		"preview:e2e": "npm run build:e2e && vite preview --base ./",
		"test": "../../node_modules/.bin/vitest --run"
	},
	"dependencies": {
		"@parenting/memory": "0.1.0",
		"@parenting/orchestrator": "0.1.0",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@playwright/test": "1.49.1",
		"@types/react": "19.2.0",
		"@types/react-dom": "19.2.2",
		"@vitejs/plugin-react": "4.3.4",
		"typescript": "5.9.3",
		"vite": "6.0.5",
		"vitest": "3.2.4"
	},
	"license": "MIT"
}
