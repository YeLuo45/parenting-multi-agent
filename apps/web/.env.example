# Real LLM API keys. Copy this file to apps/web/.env and fill in.
# Either key activates its provider; missing keys are skipped.
#
# minimax-m3 (Anthropic-compatible, https://api.minimaxi.com/v1)
# Recommended for the primary tier — same provider the Hermes CLI uses.
MINIMAX_CN_API_KEY=

# xiaomi MiMo (OpenAI-compatible, https://token-plan-cn.xiaomimimo.com/v1)
# Secondary fallback when minimax is rate-limited.
XIAOMI_API_KEY=
