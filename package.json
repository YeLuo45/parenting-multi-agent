{
	"name": "parenting-multi-agent",
	"private": true,
	"type": "module",
	"description": "AI-powered parenting assistant from birth to college — 8 specialized agents (pediatrician/psychologist/educator/nutritionist/sleep-coach/family-mediator/finance/parent-support)",
	"workspaces": [
		"packages/orchestrator",
		"packages/agents/pediatrician",
		"packages/agents/psychologist",
		"packages/agents/educator",
		"packages/agents/nutritionist",
		"packages/agents/sleep-coach",
		"packages/agents/family-mediator",
		"packages/agents/finance",
		"packages/agents/parent-support",
		"packages/agents/growth-tracker",
		"packages/agents/habit-builder",
		"packages/agents/knowledge-rag",
		"packages/agents/safety-guard",
		"packages/agents/social",
		"packages/agents/school-readiness",
		"packages/agents/college-prep",
		"packages/agents/career",
		"packages/agents/legal",
		"packages/agents/sibling",
		"packages/memory",
		"packages/cli",
		"packages/tui",
		"apps/web"
	],
	"scripts": {
		"clean": "npm run clean --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"build:agents": "npm run build -w @parenting/orchestrator -w @parenting/memory",
		"build:web": "npm run build -w @parenting/web",
		"check": "biome check --write --error-on-warnings . && tsgo -b --noEmit",
		"test": "node --test test/*.test.mjs && npm run test --workspaces --if-present",
		"test:coverage": "npm run test --workspaces --if-present -- --coverage",
		"test:vitest": "./test.sh",
		"dev:web": "node scripts/run-workspace-dev.mjs @parenting/web dev",
		"dev:tui": "node scripts/run-workspace-dev.mjs @parenting/tui start",
		"dev:cli": "node scripts/run-workspace-dev.mjs @parenting/cli start",
		"start:cli": "npm run start -w @parenting/cli",
		"start:tui": "npm run -w @parenting/tui start --",
		"version:patch": "npm version patch -ws --no-git-tag-version",
		"version:minor": "npm version minor -ws --no-git-tag-version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@vitest/coverage-v8": "3.2.4",
		"better-sqlite3": "11.3.0",
		"esbuild": "0.28.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"version": "0.1.0",
	"overrides": {
		"rimraf": "6.1.2"
	},
	"dependencies": {
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/better-sqlite3": "7.6.13",
		"jsdom": "29.1.1"
	}
}
