{
	"name": "@parenting/memory",
	"version": "0.1.0",
	"description": "L0-L4 hierarchical child memory with SQLite persistence (PowerSync-ready for cloud sync)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"better-sqlite3": "11.3.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "7.6.10",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "2.1.9"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	}
}
